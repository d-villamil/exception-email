# Delivery mode: draft (creates Gmail drafts) or send (sends live).
OUTREACH_MODE=draft

# Gmail OAuth — service account or installed-app credentials authorized for dashlinkmm@gmail.com.
GMAIL_OAUTH_CREDENTIALS=./secrets/gmail-oauth.json
GMAIL_TOKEN_PATH=./state/gmail-token.json
GMAIL_FROM=dashlinkmm@gmail.com

# Contacts workbook (Carriers tab is required; Mx tab unused in MVP).
CONTACTS_XLSX=../T&T Contacts.xlsx

# Local state.
SENT_STORE_PATH=./state/sent-shipments.json
AUDIT_LOG_PATH=./state/audit.jsonl

# parcel-cli — primary source. The binary has no filter flags; we apply
# is_late + blank-exception checks in our code. Facility and time range come
# from the active session (set via `parcel-cli use <facility>` and
# `parcel-cli timerange -s YYYY-MM-DD -e YYYY-MM-DD`).
PARCEL_CLI_BIN=parcel-cli
PARCEL_CLI_ARGS=shipment list --format json

# Trino — fallback. TODO: confirm catalog/schema/table.
TRINO_HOST=
TRINO_USER=
TRINO_CATALOG=
TRINO_SCHEMA=

# Slack channel for Warp.
SLACK_CHANNEL_WARP=#warp_dd_ops_ext

# Eligibility threshold (minutes).
LATE_THRESHOLD_MIN=15

# Run timezone (informational; the scheduler handles cadence).
RUN_TZ=America/Los_Angeles
